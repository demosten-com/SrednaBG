# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.DS_Store
local.properties

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.serena/

# Android
*.apk
*.aab
*.ap_
*.dex

# Backend
backend/tiles/*.mbtiles
backend/data/map-bundle/
backend/data/map-bundle.zip
backend/.cache/

# Bundled map assets (generated by backend/scripts/build-map-bundle.sh + prepareMapAssets)
android/app/src/main/assets/map/

# Bundled zone data — generated at build time by the prepareZonesAsset Gradle task
# from backend/data/zones.json (the single source of truth shared with iOS), so
# both platforms ship identical zone data per release. Don't commit this copy.
android/app/src/main/assets/zones.json

# Environment
.env

# Local-only test fixtures (GPX routes, sample JSON, throwaway data)
test-data/
.playwright-mcp/

# QA harness artifacts — reports + generated GPX fixtures (the YAMLs are checked in)
qa/reports/
qa/out/
qa/fixtures/gpx/
qa/fixtures/tts_phrases.yaml

# Claude Code local harness state (skills/ stays tracked for contributors)
.claude/settings.local.json
.claude/scheduled_tasks.lock
